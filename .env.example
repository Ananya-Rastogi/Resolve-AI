# ==============================================================================
# Enterprise Multi-Agent Ticket Routing & RAG System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Persistence (Optional for Cloud DB)
# If left blank, the system automatically falls back to persistent local SQLite
# at data/tickets_dev.db without crashing or failing.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key-here
USE_LOCAL_DB=false
SQLITE_DB_PATH=data/tickets_dev.db

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins for React Frontend
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AI & Multi-Agent LangGraph Settings
# ------------------------------------------------------------------------------
# Confidence threshold below which tickets route to LLM structured fallback (0.0 - 1.0)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.50

# Optional OpenAI API key for production LLM calls (defaults to offline MockLLMClient if omitted)
# OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 4. ChromaDB Vector Store Path
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=data/chroma
FAQ_CSV_PATH=data/rag_faqs.csv
